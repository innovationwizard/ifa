# -----------------------------------------------------------------------------
# IFA — Environment variables template
# Copy this file to .env.local for local development. Never commit .env*.
# Values below are placeholders only — no real secrets in this file.
# -----------------------------------------------------------------------------

# ---------- Site ----------
# Canonical URL used for absolute metadata (OG/Twitter images, sitemap).
# In Vercel production this can stay unset (VERCEL_URL is auto-injected and
# we fall back to https://$VERCEL_URL). Set explicitly when a custom domain
# is attached. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase (single `ifa` project; main branch = production) ----------
# Public URL of the Supabase project (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key — safe to expose. Used by the browser Supabase client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only service role key. NEVER expose to the browser. Used by
# trusted server code that bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Pooled Postgres connection for runtime queries via Prisma on Vercel.
# Port 6543, pgbouncer=true, connection_limit=1 per scaffolding §D-4.
DATABASE_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Direct (non-pooled) Postgres connection for `prisma migrate` only.
# Port 5432. Used exclusively by schema migrations; never by runtime code.
DIRECT_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ---------- Anthropic (Claude API) ----------
# Server-only. Used by the AI categorization, insights, and recommendation
# services. Rotate on leak; never expose to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# ---------- Demo mode ----------
# When `true`, the app boots with a synthetic "DEMO" organization and a
# persistent banner. MUST be set only on the dedicated `ifa-demo` Vercel
# project — never on production. See docs/_IFA_BUILD_PLAN.md §S-10.7.
NEXT_PUBLIC_DEMO_MODE=false

# ---------- Stripe (OPTIONAL — billing is non-blocking) ----------
# All four vars below are OPTIONAL during early development. When
# STRIPE_SECRET_KEY is unset, checkout/portal routes short-circuit and
# the app runs in a trial-only, free mode. All new profiles still get
# their 30-day trial + 30-day soft-gate window; the hard gate simply
# can't be reached without Stripe wired up.
#
# Server-only secret key (`sk_test_*` for test mode, `sk_live_*` for prod).
STRIPE_SECRET_KEY=
# Signing secret for /api/stripe/webhook. Generated when you register the
# webhook endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
# Price ids for the two plans. Create them in the Stripe dashboard as
# recurring monthly prices: USD $1 for individual, USD $20 for business.
STRIPE_PRICE_INDIVIDUAL_ID=
STRIPE_PRICE_BUSINESS_ID=

CRON_SECRET=

# ---------- Transactional email (OPTIONAL — provider-agnostic, Phase L4) ----------
# IFA's email layer supports BOTH Resend AND AWS SES via a single typed
# interface. Choose ONE provider per environment by setting EMAIL_PROVIDER.
# When unset, sendEmail() logs the would-be send and returns
# `{status:'skipped'}` — the app stays functional with no email infra
# (Supabase Auth still sends magic links via its own default sender unless
# the founder has also configured Supabase SMTP — see vercel-setup.md).
#
# EMAIL_PROVIDER     'resend' | 'ses'
# EMAIL_FROM_ADDRESS sender address — must be DKIM/SPF-verified at the provider
# EMAIL_FROM_NAME    display name shown in the From header
EMAIL_PROVIDER=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# Resend (required when EMAIL_PROVIDER=resend)
# Create at resend.com → API Keys; scope to "Sending access" only.
RESEND_API_KEY=

# AWS SES (required when EMAIL_PROVIDER=ses)
# Use a dedicated IAM user with the AmazonSesSendingAccess managed policy
# (NOT root credentials, NOT a broader policy). Namespaced AWS_SES_* so
# the credentials never collide with other AWS integrations.
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
